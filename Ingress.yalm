apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: notary-api-ingress
  namespace: default
  annotations:
    kubernetes.io/ingress.allow-http: "false"
    kubernetes.io/ingress.global-static-ip-name: "notary-api-static-ip"
    networking.gke.io/managed-certificates: "notary-api-cert"
spec:
  rules:
  - host: app.notarialsolutions.com 
    http:
      paths:
      - backend:
          service:
            name: notary-api-lb
            port:
              number: 80
        path: /
        pathType: Prefix
