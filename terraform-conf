terraform {
  required_providers {
    google = {
      source  = "hashicorp/google"
      version = "~> 5.0"
    }
    kubernetes = {
      source  = "hashicorp/kubernetes"
      version = "~> 2.0"
    }
  }
}

provider "google" {
  project = "notary-management-web-platform"
  region  = "us-central1"
}

# Image tag inputs to easily toggle versions during CD pipelines
variable "hello_image_tag" {
  type        = string
  description = "The tag of the hello (notary-api) container image."
  default     = "5b9ab8499544f117865fc8730e1d2be4d9deb524"
}

variable "nginx_image_tag" {
  type        = string
  description = "The tag/version of the nginx sidecar image."
  default     = "alpine"
}

# Retrieve GKE connection credentials dynamically
data "google_client_config" "default" {}

data "google_container_cluster" "primary" {
  name     = "deployment-1-cluster"
  location = "us-central1"
}

# Authenticate the Kubernetes provider with GKE master credentials
provider "kubernetes" {
  host                   = "https://${data.google_container_cluster.primary.endpoint}"
  token                  = data.google_client_config.default.access_token
  cluster_ca_certificate = base64decode(data.google_container_cluster.primary.master_auth[0].cluster_ca_certificate)
}

# Deploy the corrected manifest with correct image paths
resource "kubernetes_deployment_v1" "notary_api" {
  metadata {
    name      = "notary-api"
    namespace = "default"
    labels = {
      app = "notary-api"
    }
  }

  spec {
    replicas = 2

    selector {
      match_labels = {
        app = "notary-api"
      }
    }

    template {
      metadata {
        labels = {
          app        = "notary-api"
          commit-sha = "e2a3d71514ee1a78dba7d44bff7454546d433857"
        }
      }

      spec {
        service_account_name = "notary-api"

        container {
          name  = "hello"
          # Points to the correct nested Artifact Registry image path
          image = "gcr.io/notary-management-web-platform/github.com/dimurano/notary-management-web-platform:${var.hello_image_tag}"

          env {
            name  = "ENVIRONMENT"
            value = "production"
          }

          resources {
            limits = {
              cpu    = "1"
              memory = "1280Mi"
            }
            requests = {
              cpu    = "1"
              memory = "1280Mi"
            }
          }

          startup_probe {
            initial_delay_seconds = 10
            period_seconds        = 10
            failure_threshold     = 24

            tcp_socket {
              port = "8080"
            }
          }
        }

        container {
          name  = "nginx"
          # Points to official Docker Hub nginx:alpine image
          image = "nginx:${var.nginx_image_tag}"

          port {
            container_port = 80
            name           = "http"
          }

          resources {
            limits = {
              cpu    = "500m"
              memory = "256Mi"
            }
            requests = {
              cpu    = "500m"
              memory = "256Mi"
            }
          }

          liveness_probe {
            initial_delay_seconds = 15
            period_seconds        = 20

            http_get {
              path = "/"
              port = "80"
            }
          }
        }
      }
    }
  }
}
